# Solana 네트워크 설정
#  - devnet  : https://api.devnet.solana.com  / solana-devnet
#  - localnet: http://127.0.0.1:8899          / solana-localnet (solana-test-validator 필요)
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_NETWORK=solana-devnet

# devnet USDC 민트 (Circle devnet faucet에서 받는 USDC)
# ※ scripts/setup_devnet.py 는 자체 테스트 USDC 민트를 새로 만들어 이 값을 덮어씁니다
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
USDC_DECIMALS=6

# 토큰화 주식 민트 — scripts/setup_devnet.py 실행 후 출력값으로 채우세요
STOCK_SYMBOL=tAAPL
STOCK_MINT=
STOCK_DECIMALS=6

# 예산/한도 (AP2 mandate)
BUDGET_USDC=100
PER_TRADE_MAX_USDC=50

# A8 브로커 수수료 (bps) — 30 = 0.3%. 소개서 수익모델 수치와 일치시킬 것
# ※ 0.1%(10) 인하안("업계 최저 수수료" 어필)은 최종 제출 전 재검토
BROKER_FEE_BPS=30

# 지갑 키페어 저장 위치 (절대 커밋 금지 — .gitignore 로 차단됨)
WALLET_DIR=secrets

# --- Gemini (무료 티어) — 키가 없으면 규칙 기반으로 동작 ---
# https://aistudio.google.com 에서 발급 (연결 확인: python scripts/check_gemini.py)
GEMINI_API_KEY=
# flash-latest(=3.6-flash)는 무료 티어 하루 20회 제한 — 라이트가 데모용으로 안전
GEMINI_MODEL=gemini-flash-lite-latest
# developer(AIza… 키) / vertex(AQ.… 새 형식 키) / 빈값=키 형식으로 자동 판별
GEMINI_MODE=

# --- Firestore 영속화 (Cloud Run 배포 — docs/deploy_cloud_run.md) ---
# 로컬 기본 OFF: 켜려면 gcloud auth application-default login 후 1 로 설정.
# Cloud Run 에서는 서비스 계정(ADC)으로 자동 인증되므로 FIRESTORE_ENABLED=1 만 주면 된다.
FIRESTORE_ENABLED=
FIRESTORE_PROJECT=
FIRESTORE_DATABASE=
FIRESTORE_PREFIX=autotrader

# --- 웹 대시보드 (python -m web.server) ---
WEB_PORT=8000
# 시세 틱 간격(초) — Gemini 무료 티어 분당 호출 제한 고려, 데모 속도 조절용
WEB_TICK_INTERVAL_SEC=8
# B2 데일리 브리핑 자동 생성 시각(HH:MM, 서버 로컬 시간) — 장 마감 시각, 하루 1회
DAILY_BRIEFING_TIME=16:00
