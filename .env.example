# Solana 네트워크 설정
#  - devnet  : https://api.devnet.solana.com  / solana-devnet
#  - localnet: http://127.0.0.1:8899          / solana-localnet (solana-test-validator 필요)
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_NETWORK=solana-devnet

# devnet USDC 민트 — 이 기본값이 Circle 공식 devnet USDC 입니다
# ※ scripts/setup_devnet.py 는 기본적으로 이 값을 그대로 씁니다(같은 값을 .env 에 다시 적습니다).
#    설정된 민트의 발행 권한이 우리 지갑이면 "자기가 찍은 돈으로 지불"이 되므로 중단합니다.
#    자체 발행이 필요하면 --self-mint-usdc 로 명시해야 하고, 그 결과물은 심사 증빙에 쓸 수 없습니다.
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
USDC_DECIMALS=6

# 토큰화 주식 민트 — scripts/setup_devnet.py 실행 후 출력값으로 채우세요
# ※ 주식 쪽은 devnet 에 실물이 없어 자체 발행이 유일한 방법입니다(문서에 명시하고 있습니다)
STOCK_SYMBOL=tAAPL
STOCK_MINT=
STOCK_DECIMALS=6
# 멀티 종목(동시 매수) — 콤마 구분. 비우면 STOCK_SYMBOL 하나만 씁니다
STOCK_SYMBOLS=

# 예산/한도 (AP2 mandate)
BUDGET_USDC=100
PER_TRADE_MAX_USDC=50

# A8 브로커 수수료 (bps) — 30 = 0.3%. 소개서 수익모델 수치와 일치시킬 것
# ※ 0.1%(10) 인하안("업계 최저 수수료" 어필)은 최종 제출 전 재검토
BROKER_FEE_BPS=30

# 지갑 키페어 저장 위치 (절대 커밋 금지 — .gitignore 로 차단됨)
WALLET_DIR=secrets
# Cloud Run 대안: 파일 마운트 대신 키페어 JSON 배열을 환경변수로 주입 (Secret Manager)
TRADING_KEYPAIR_JSON=
BROKER_KEYPAIR_JSON=
# 사용자(위임자) 키 — open mandate 서명자(에이전트 키와 분리). 없으면 secrets/user.json 자동 생성.
USER_KEYPAIR_JSON=

# --- 공개 배포 보호 (로컬은 비워 두면 기존과 동일하게 무인증) ---
# 값을 넣으면 상태를 바꾸는 POST /api/* 에 X-Control-Token 헤더를 요구한다.
# 대시보드는 주소 끝에 #token=<값> 을 한 번 붙여 접속하면 저장한다. 읽기(GET·SSE)는 공개.
CONTROL_TOKEN=
# 서버측 예산 상한 — 외부에서 한도를 무한대로 올리는 것을 차단
MAX_BUDGET_USDC=10000
# 웹에서 라이브(실제 온체인 전송) 세션 시작 허용 — 배포에서는 0 으로 두고 시연 직전에만 1
# (config.py:83 기본값도 0 입니다. 여기 1 이 적혀 있어 바로 위 주석·코드와 반대였습니다 — 정정)
ALLOW_LIVE_FROM_WEB=0

# --- Gemini (무료 티어) — 키가 없으면 규칙 기반으로 동작 ---
# https://aistudio.google.com 에서 발급 (연결 확인: python scripts/check_gemini.py)
GEMINI_API_KEY=
# ※ 쿼터는 모델별로 따로 계산됩니다. 2026-07-27 에 lite 의 일일 한도가 먼저 소진돼
#    배포는 gemini-flash-latest 로 운용 중입니다(docs/deploy_cloud_run.md §4).
#    두뇌를 붙인 세션에서 쿼터가 없으면 설계대로 매수가 전건 보류됩니다.
GEMINI_MODEL=gemini-flash-lite-latest
# developer(AIza… 키) / vertex(AQ.… 새 형식 키) / 빈값=키 형식으로 자동 판별
GEMINI_MODE=

# --- Firestore 영속화 (Cloud Run 배포 — docs/deploy_cloud_run.md) ---
# 로컬 기본 OFF: 켜려면 gcloud auth application-default login 후 1 로 설정.
# Cloud Run 에서는 서비스 계정(ADC)으로 자동 인증되므로 FIRESTORE_ENABLED=1 만 주면 된다.
FIRESTORE_ENABLED=
FIRESTORE_PROJECT=
FIRESTORE_DATABASE=
FIRESTORE_PREFIX=autotrader

# --- 시세 피드 ---
# replay = 실데이터 CSV 재생(data/market/) · mock = 8스텝 목 시세. 세션 시작 시 UI 선택이 우선.
PRICE_FEED=replay
# 일봉 수집용(scripts/fetch_market_data.py). 런타임에는 쓰지 않습니다 — 없어도 앱은 돕니다.
ALPHAVANTAGE_API_KEY=

# --- 브로커 HTTP 402 레그 (G5) ---
# 값을 넣으면 매수 레그가 원격 HTTP 로 나갑니다(POST /broker/orders → 402 → X-PAYMENT).
# 비워 두면 기존 인프로세스 경로 그대로. 배포·시연에서는 비워 둡니다
# (무인증 POST 로 대기열을 채우는 경로가 열리므로 — docs/deploy_cloud_run.md 참고).
# 402 응답 자체는 값 없이도 curl -i <url>/broker/orders 로 확인됩니다.
BROKER_HTTP_URL=

# --- 웹 대시보드 (python -m web.server) ---
WEB_PORT=8000
# 시세 틱 간격(초) — Gemini 무료 티어 분당 호출 제한 고려, 데모 속도 조절용
WEB_TICK_INTERVAL_SEC=8
# B2 데일리 브리핑 자동 생성 시각(HH:MM, 서버 로컬 시간) — 장 마감 시각, 하루 1회
DAILY_BRIEFING_TIME=16:00
