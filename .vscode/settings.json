{
  // 이 저장소의 가상환경(.venv)을 기본 인터프리터로 쓴다.
  //
  // 왜: 전역 파이썬에는 python-dotenv·google-genai 가 없다(실측). 그쪽을 보고 있으면
  // Pylance 가 config.py 의 `from dotenv import load_dotenv` 와 Gemini 두뇌의
  // `from google import genai` 를 "resolve 할 수 없음" 으로 표시한다(노란 물결).
  //
  // macOS/Linux 는 ".venv/bin/python" 이다. 이 값은 어디까지나 **기본값**이라, 이미
  // 워크스페이스에 인터프리터를 고른 적이 있으면 그 선택이 이긴다 — 그때는 명령 팔레트에서
  // "Python: Select Interpreter" 로 .venv 를 한 번 골라야 한다.
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python.exe",

  // 저장소 루트를 분석 경로에 넣는다.
  //
  // 왜: scripts/*.py 는 sys.path.insert(0, ROOT) 로 루트를 추가한 뒤 config·payments·web 을
  // import 한다. Pylance 는 그 런타임 조작을 따라가지 못해서, 실행은 되는데 편집기에서만
  // "config 를 찾을 수 없음" 으로 보인다.
  "python.analysis.extraPaths": ["${workspaceFolder}"],

  // 통합 터미널을 열면 .venv 를 자동 활성화한다 — `python -m scripts.test_*` 를 그냥 칠 수 있게.
  "python.terminal.activateEnvironment": true
}
